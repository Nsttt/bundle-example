{
  "compilerOptions": {
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent-bundle.config.ts",
    ".agent-bundle/routes.d.ts",
    "rstest.*.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "evals/**/*.ts"
  ]
}
